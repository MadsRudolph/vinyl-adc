	)
	(text "POWER  (Pi +5V -> charge-pump -5V -> +/-2.5V DAC reference)"
		(at 20.32 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "65eec339-0470-4eca-8061-6d499d8ae223")
	)
	(text "Reservoir sits AT the DAC gate: the DAC's mean supply current"
		(at 20.32 58.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c49e2045-4126-40c1-8e64-a998a3fb4689")
	)
	(text "is proportional to the signal, so this rail must be LOW"
		(at 20.32 60.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "020b3e26-d758-41a1-ba8d-3a33293a05b8")
	)
	(text "IMPEDANCE, not filtered by a series R."
		(at 20.32 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8f35b8c2-27f8-4d92-aeb1-beac7de27d85")
	)
	(text "2 x 8 buffers paralleled: half the 16 ohm output"
		(at 77.47 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "21ac0989-9e26-476e-8237-f90a22492b10")
	)
	(text "resistance of one package, ~0.6 V more rail (10b)"
		(at 77.47 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "02875126-3689-4a51-b024-703e3fa2a2e5")
	)
	(text "192 kHz pump drive = 4x the 48 kHz output rate,"
		(at 132.08 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "108e9bb0-9d66-48c1-9585-18d304b027a9")
	)
	(text "so residual ripple lands on a CIC decimator null."
		(at 132.08 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1be5dc8a-cee2-4fe2-a43f-237dd1a5bd14")
	)
	(text "REFERENCE  (+/-2.5V, ratiometric -- tracks +5V so rail noise cancels as gain, not additive noise)"
		(at 307.34 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "a8060848-51e0-4992-b7c8-ad0a28b7e419")
	)
	(text "ANALOG ISLAND  +5VA  (10 uH + 470 u, fc 2.3 kHz)"
		(at 469.9 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "131e5b6d-3572-42fd-a1e8-804de4ecbde7")
	)
	(text "~35 dB down at the pump's 192 kHz.  Feeds the op-amps, the"
		(at 474.98 59.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "73f0a6f0-99af-4cb5-bd9a-16b3bfdedf42")
	)
	(text "comparators' bias, the DAC gates and the reference, so the"
		(at 474.98 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "78025807-7dbe-4ffa-a9f6-b8c28f99b5b4")
	)
	(text "reference stays ratiometric to the gates' own rail.  Both"
		(at 474.98 64.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f62503d0-47e3-4519-b0d5-111bd3112570")
	)
	(text "chokes are SRR1260 10 uH SMD; L1 is the inlet from the"
		(at 474.98 67.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2fbdd5aa-b135-4f8a-a3c6-5516e930a03e")
	)
	(text "Pi.  Neither is a resistor: DCR ~ 0.05 R keeps the DAC"
		(at 474.98 69.85 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "62bbb70c-c355-41cf-afe3-e77f3953bb71")
	)
	(text "reference stiff (design-notes 6)."
		(at 474.98 72.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "faf49abd-31a3-494c-ad8d-894d259fe8a6")
	)
	(text "CLOCK AND DIGITAL  (6.144 MHz -> /2 BCLK 3.072M, /4 MCLK 1.536M, /128 LRCLK 48k;  L and R interleaved onto one DIN)"
		(at 20.32 157.48 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "ee34faab-9356-465a-b82a-ac89f55c0bdc")
	)
	(text "Jumper 1-2 = crystal Pierce (ps jitter -> ~100 dB floor)."
		(at 20.32 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "104bb40e-e255-467a-ae91-c332da65667a")
	)
	(text "Jumper 2-3 = Pi GPCLK0: ~1 ns -> 68 dB floor, the dominant"
		(at 20.32 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5ab7e1b7-acb4-4149-8def-8278799a06ea")
	)
	(text "noise source if left there.  Bring-up only."
		(at 20.32 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b85c8d47-6573-42fe-94f5-5c832da8ee06")
	)
	(text "U3B buffers LRCLK for the clock-alive LED; other spares tied low"
		(at 127 241.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3ca4968e-d145-4fc0-ad47-be8734c049d4")
	)
	(text "Q0=BCLK 3.072M  Q1=MCLK 1.536M"
		(at 180.34 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e8567aaf-913c-4688-a59a-3c683f3a05da")
	)
	(text "Q4=PUMP 192k  Q6=LRCLK 48k"
		(at 180.34 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9f3cd74f-cefb-4f2c-9a5b-b098f8e0e42d")
	)
	(text "MCLK selects: DIN carries R,L,R,L... at 3.072 Mbps."
		(at 251.46 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "99980985-e929-49bb-878e-f4f76468d660")
	)
	(text "64 BCLK per LRCLK frame = 32 L bits + 32 R bits"
		(at 251.46 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cdc0c988-5d6d-4f07-9ce2-20723840827e")
	)
	(text "= exactly one OSR-32 sample per channel."
		(at 251.46 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "13c065df-0648-469b-8502-29472c8324d3")
	)
	(text "LEVEL SHIFT to 3.3 V.  74HC4049 tolerates inputs above its own"
		(at 332.74 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5a17cfee-b064-41b0-82b8-727ba3291f04")
	)
	(text "VCC, which is exactly what makes it legal here.  Two inverters"
		(at 332.74 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4fb38ea1-9f07-4db1-bd5c-7f0297faa8c6")
	)
	(text "per signal so BCLK polarity is preserved -- inverting BCLK would"
		(at 332.74 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "82edd0b8-971e-447f-a791-c58c53728b94")
	)
	(text "make the Pi sample on the data transition."
		(at 332.74 177.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fe11664c-8e1f-4b5d-ace6-9ad14d7fafb9")
	)
	(text "RASPBERRY PI 4 on a 2x20 socket, mounted UNDER the board."
		(at 421.64 251.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dcc61b99-f3b9-4ca6-85e2-d3ec1ebcfc92")
	)
	(text "1/17=3V3  2/4=5V in (through FB1 onto +5V)  7=GPCLK0 GPIO4"
		(at 421.64 254 0)
		(effects
			(font
				(size 1.27 1.27)
