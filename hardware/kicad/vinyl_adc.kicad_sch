			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "2f05ca03-215d-4d42-b158-1fe7e5372e7b")
	)
	(text "Reservoir sits AT the DAC gate: the DAC's mean supply current"
