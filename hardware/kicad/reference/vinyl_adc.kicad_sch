				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "185a11b2-3691-41f8-af92-09c4e9197989")
	)
	(text "LEVEL SHIFT to 3.3 V.  74HC4049 tolerates inputs above its own"
		(at 294.64 130.81 0)
