			)
			(justify left bottom)
		)
		(uuid "9e887210-2d1b-41ec-bfee-485395ce5d13")
	)
	(text "REFERENCE  (+/-2.5V, ratiometric -- tracks +5V so rail noise cancels as gain, not additive noise)"
		(at 307.34 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "b957cb1f-6479-405e-b78c-9874356c8dd2")
	)
	(text "CLOCK AND DIGITAL  (6.144 MHz -> /2 BCLK 3.072M, /4 MCLK 1.536M, /128 LRCLK 48k;  L and R interleaved onto one DIN)"
		(at 20.32 118.11 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "b8c02438-8a77-4860-bc37-07ec0e8a2f96")
	)
	(text "Jumper 1-2 = on-board can (crystal jitter 20 ps -> 102 dB floor)."
		(at 20.32 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ee8e0c3b-4143-4e3b-9554-db9f443a4697")
	)
	(text "Jumper 2-3 = Pi GPCLK0 fallback: ~1 ns jitter -> 68 dB floor,"
		(at 20.32 179.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "62c38a57-9376-47cd-9a77-1f7a9d61f275")
	)
	(text "which would become the dominant noise source.  Bring-up only."
		(at 20.32 181.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "78873d19-e2f3-4437-8b6b-7f3869589034")
	)
	(text "spare gates: inputs tied low"
		(at 88.9 201.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "caff1b17-40bf-4b98-805c-573c0e91dee8")
	)
	(text "Q0=BCLK 3.072M  Q1=MCLK 1.536M"
		(at 142.24 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c1ca7883-f490-41f1-84ea-0bbba1b6f075")
	)
	(text "Q4=PUMP 192k  Q6=LRCLK 48k"
		(at 142.24 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c82c120c-96c2-43af-9834-e2e39af1f668")
	)
	(text "MCLK selects: DIN carries R,L,R,L... at 3.072 Mbps."
		(at 213.36 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dfc748e9-4478-49bd-aae0-57c614f51852")
	)
	(text "64 BCLK per LRCLK frame = 32 L bits + 32 R bits"
		(at 213.36 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6f2b3899-cdbd-44dd-b229-1c8be318670b")
	)
	(text "= exactly one OSR-32 sample per channel."
