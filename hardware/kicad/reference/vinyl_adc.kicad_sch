			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6922901c-56b5-4df0-8df9-49c43cd0d7d7")
	)
	(text "VCC, which is exactly what makes it legal here.  Two inverters"
