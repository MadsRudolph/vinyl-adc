	(text "POWER  (Pi +5V -> charge-pump -5V -> +/-2.5V DAC reference)"
		(at 20.32 12.7 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "d91d607d-c7be-4c2f-9ef4-e46802910171")
	)
	(text "Reservoir sits AT the DAC gate: the DAC's mean supply current"
		(at 20.32 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4d42c08e-82d7-4b60-91ee-992755e2fce9")
	)
	(text "is proportional to the signal, so this rail must be LOW"
		(at 20.32 59.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5093bb43-41d2-48a7-8d25-b9f1a1e40a33")
	)
	(text "IMPEDANCE, not filtered by a series R."
		(at 20.32 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b45eb2ee-8744-4ed0-88e0-92a423c815c3")
	)
	(text "8 buffers paralleled ~= 32 mA;"
		(at 60.96 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "91aeae1a-31e1-4fdd-8b19-55534013572b")
	)
	(text "no charge-pump IC in the shop"
		(at 60.96 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ce53986b-6d83-457d-9906-61600e96fd6c")
	)
	(text "192 kHz pump drive = 4x the 48 kHz output rate,"
		(at 115.57 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0fe6661e-4aac-43fe-90bf-4c4fd2d7bbf7")
	)
	(text "so residual ripple lands on a CIC decimator null."
		(at 115.57 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "21acd2d9-4973-4e80-8bc3-c3a2f145d187")
	)
