		(uuid "61c0d17c-e6ec-46d7-9abe-6a0ab0f10a58")
	)
	(text "QUANTISER AND 1-BIT DAC  (comparator in from each channel, re-clocked on MCLK, DAC drive back out)"
		(at 20.32 101.6 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "57b8bee1-5bd5-4689-b5ea-440ca0281614")
	)
	(text "1-BIT DAC DRIVE"
		(at 165.1 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d4b51526-f665-409d-bf4e-0e72d7002df3")
	)
	(text "DACN = /Q, DACP = Q (taken from Q and /Q so the"
		(at 165.1 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "31bbd713-f4a8-471b-a731-b1ffad949b1d")
	)
	(text "two edges are as close to simultaneous as the parts allow)"
		(at 165.1 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a244098a-6f7f-43d5-a2c4-49176afac2cc")
	)
	(text "TO THE DIGITAL BOARD, 12-way IDC ribbon.  Odd pins are all GND, so"
		(at 236.22 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "92824dd2-d2c4-41c7-bd6e-c247247b8ba0")
	)
	(text "every signal conductor has a grounded neighbour either side of it."
		(at 236.22 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2d47cded-4dff-4fc3-86e7-f3e799acd743")
	)
	(text "Shrouded and keyed: reversed, pin 2 (+5V) would meet pin 11 (GND)."
		(at 236.22 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f02517e8-a29c-4129-b277-d99f14ce6142")
	)
	(text "RIBBONS TO THE CHANNEL BOARDS  (same 14-way pinout on both, so one artwork serves L and R)"
		(at 20.32 182.88 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "8883dc31-0417-48a2-901c-06518e4b776a")
	)
	(text "TO CHANNEL L, 14-way IDC ribbon.  Both supplies, both references,"
		(at 25.4 251.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fd1d3b86-d85a-4ba3-8509-67bf530157bd")
	)
	(text "and the three nets that carry the modulator loop across: the"
		(at 25.4 254 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "554f11c8-a093-44b1-9b68-f7f9485e500b")
	)
	(text "comparator out, and the DAC's two drives back to the summing"
		(at 25.4 256.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "acaec792-985b-494d-9a20-05a804fb1a4c")
	)
	(text "junctions.  Odd pins are all GND.  Shrouded and keyed."
		(at 25.4 259.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0c222c37-a8ed-4dc7-bbc9-47b53f3c69bc")
	)
	(text "TO CHANNEL R, 14-way IDC ribbon.  Both supplies, both references,"
