		)
		(uuid "4c7b9dd3-3a55-4025-ac9d-d34fc2c1369a")
	)
	(global_label "PI_LRCLK"
		(shape input)
		(at 238.76 158.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0e446571-5a0b-4bc5-9d6e-3783f1e8d7fb")
	)
	(global_label "DIN"
		(shape input)
		(at 187.96 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6b6ef9f0-aff1-4be1-abf8-e9640da026c3")
	)
	(global_label "PI_DIN"
		(shape input)
		(at 238.76 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e4f2aa97-9e6c-482b-bf1a-c94d7f7fef2f")
	)
	(text "CLOCK  (6.144 MHz -> /2 BCLK 3.072M, /4 MCLK 1.536M, /32 PUMP 192k, /128 LRCLK 48k)"
		(at 20.32 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "449a9415-e2df-476c-b311-a98456cb6fa4")
	)
	(text "Jumper 1-2 = crystal Pierce (ps jitter -> ~100 dB floor)."
		(at 20.32 72.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3dce9655-916d-4e40-b669-f81fd5b27a72")
	)
	(text "Jumper 2-3 = Pi GPCLK0: ~1 ns -> 68 dB floor, the dominant"
		(at 20.32 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "861b8ef7-3d13-47a9-9a60-62f62f244468")
	)
	(text "noise source if left there.  Bring-up only."
		(at 20.32 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bf086e1f-ac62-4708-af08-174a2fd7eb86")
	)
	(text "spare gates: inputs tied low"
		(at 127 97.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b6ec0c8b-d0cc-4c76-80f8-2adb23443076")
	)
	(text "Q0=BCLK 3.072M  Q1=MCLK 1.536M"
		(at 180.34 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6dae7bca-5c5d-4178-a02b-2a0f20f701c8")
	)
	(text "Q4=PUMP 192k  Q6=LRCLK 48k"
		(at 180.34 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "669f984b-4d67-4d18-97f0-882bd1e32ecd")
	)
	(text "Pi pins: 1=+5V(pin2)  2=GND(6)  3=+3V3(1)"
		(at 284.48 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d5ba26e9-51e8-4414-bfb3-aa703dd873c9")
	)
	(text "4=BCLK GPIO18(12)  5=LRCLK GPIO19(35)"
		(at 284.48 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f29e0696-19e4-4e5e-9d3a-da9cfa26981c")
	)
	(text "6=DIN GPIO20(38)   7=GPCLK0 GPIO4(7)  8=GND(39)"
		(at 284.48 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "72b5ceec-0ffc-4124-a49f-f8e363be792b")
	)
	(text "Pi is I2S SLAVE: this board is the clock master."
		(at 284.48 82.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "637ae3dd-9129-464d-966e-b1a6ffbe7965")
	)
	(text "INTERLEAVE AND LEVEL SHIFT  (L and R onto one DIN at 3.072 Mbps, then 5 V -> 3.3 V for the Pi)"
		(at 20.32 113.03 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "bcbab653-35b8-420a-98bf-6f26b4824855")
	)
	(text "STACKING BUS  2x8, 2.54 mm.  Every board carries this same connector at"
		(at 17.78 184.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1f6e5642-4556-41a7-acec-d6aceb86f2c2")
	)
	(text "the same coordinates; the stack is digital, channel L, channel R, power"
		(at 17.78 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a993fef8-3037-4153-a465-040f8ff03c55")
	)
	(text "on 11 mm standoffs.  Odd pins are all GND, so every signal has a"
		(at 17.78 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b38a4679-b3f5-425d-8c97-828308100633")
	)
	(text "grounded neighbour either side -- which is what MCLK needs, its jitter"
		(at 17.78 191.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ff49ae69-5772-4523-84b1-e4eedc325c3e")
	)
	(text "being what sets this converter's noise floor."
		(at 17.78 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "aec66a3e-8f44-46dd-bb7f-8e41ee79a3f7")
	)
	(text "MCLK selects: DIN carries R,L,R,L... at 3.072 Mbps."
		(at 106.68 125.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "69304ae8-7767-4a62-99f9-dc66630125ba")
	)
	(text "64 BCLK per LRCLK frame = 32 L bits + 32 R bits"
		(at 106.68 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "edd6cb22-b5e5-4d33-b126-9e711ed17cb6")
	)
	(text "= exactly one OSR-32 sample per channel."
		(at 106.68 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7cd28e7d-a468-406a-940c-599b64888006")
	)
	(text "LEVEL SHIFT to 3.3 V.  74HC4049 tolerates inputs above its own"
		(at 193.04 125.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ce80eb5c-41c2-4ebf-9659-d425dcd9cd94")
	)
	(text "VCC, which is exactly what makes it legal here.  Two inverters"
		(at 193.04 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "85be9b26-c2cd-4a0d-a31c-710bf8e88432")
	)
	(text "per signal so BCLK polarity is preserved -- inverting BCLK would"
		(at 193.04 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "78483b2f-5247-4c83-8842-968440b8cb64")
	)
	(text "make the Pi sample on the data transition."
		(at 193.04 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c1c65217-9fcd-4ff5-ab7c-07a46e4f100a")
	)
