			)
			(justify left bottom)
		)
		(uuid "76f53175-0316-46e9-8d19-90d572ccafd8")
	)
	(global_label "PI_DIN"
		(shape input)
		(at 238.76 176.53 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ec3922e5-b158-47d8-9ec5-4af07fdc2cc2")
	)
	(text "CLOCK  (6.144 MHz -> /2 BCLK 3.072M, /4 MCLK 1.536M, /32 PUMP 192k, /128 LRCLK 48k)"
		(at 20.32 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "16e75d20-9cd7-4455-a1e5-33c08b1dbf25")
	)
	(text "Jumper 1-2 = on-board can (crystal jitter 20 ps -> 102 dB floor)."
		(at 20.32 72.39 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "82445816-3d8c-48eb-abae-8665e02f5ea9")
	)
	(text "Jumper 2-3 = Pi GPCLK0 fallback: ~1 ns jitter -> 68 dB floor,"
		(at 20.32 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6a9dffa8-bc8c-4dff-bab6-6737d4f8c13b")
	)
	(text "which would become the dominant noise source.  Bring-up only."
		(at 20.32 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a7f1c9d8-1628-4866-aa49-9bdc9aed222f")
	)
	(text "spare gates: inputs tied low"
		(at 88.9 97.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "beb8a53b-2783-4c9b-9180-a930856ac436")
	)
	(text "Q0=BCLK 3.072M  Q1=MCLK 1.536M"
		(at 142.24 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "eba2ad12-c447-4681-a514-b96f0b98aa48")
	)
	(text "Q4=PUMP 192k  Q6=LRCLK 48k"
		(at 142.24 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1799abca-0c9b-411c-b888-ec6b73d8f10f")
	)
	(text "Pi pins: 1=+5V(pin2)  2=GND(6)  3=+3V3(1)"
		(at 246.38 74.93 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "429b879c-4a7d-4b59-817d-850a7e595f88")
	)
	(text "4=BCLK GPIO18(12)  5=LRCLK GPIO19(35)"
		(at 246.38 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7aaa2ecf-b334-4749-9024-0bee36e8dd61")
	)
	(text "6=DIN GPIO20(38)   7=GPCLK0 GPIO4(7)  8=GND(39)"
		(at 246.38 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "795ee0b4-2b04-4e44-b7c5-146c74fb26d6")
	)
	(text "Pi is I2S SLAVE: this board is the clock master."
		(at 246.38 82.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d2713e45-5de3-45ab-a567-84cf09fc80c9")
	)
	(text "INTERLEAVE AND LEVEL SHIFT  (L and R onto one DIN at 3.072 Mbps, then 5 V -> 3.3 V for the Pi)"
		(at 20.32 113.03 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "2701c86f-22d5-4680-baad-c9cc8a877182")
	)
	(text "STACKING BUS  2x8, 2.54 mm.  Every board carries this same connector at"
		(at 17.78 184.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "991d5af4-0241-4f25-b8a1-637787b66657")
	)
	(text "the same coordinates; the stack is digital, channel L, channel R, power"
		(at 17.78 186.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0eee842b-1c6b-4538-aa75-6053b3f560a9")
	)
	(text "on 11 mm standoffs.  Odd pins are all GND, so every signal has a"
		(at 17.78 189.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6e7097a7-c582-4f5b-af82-361565706846")
	)
	(text "grounded neighbour either side -- which is what MCLK needs, its jitter"
		(at 17.78 191.77 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2557f181-ee49-4245-abc4-7de839510055")
	)
	(text "being what sets this converter's noise floor."
		(at 17.78 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2d896bfb-01e8-46dd-b6ab-8626e44769ad")
	)
	(text "MCLK selects: DIN carries R,L,R,L... at 3.072 Mbps."
		(at 106.68 125.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "24132f6d-66ed-4a10-8799-555549f7baf1")
	)
	(text "64 BCLK per LRCLK frame = 32 L bits + 32 R bits"
		(at 106.68 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d2fcb25f-ab84-4a23-86f0-0ed2c5a944f6")
	)
	(text "= exactly one OSR-32 sample per channel."
		(at 106.68 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cf09bd39-c7ea-4787-b703-0564339ebb08")
	)
	(text "LEVEL SHIFT to 3.3 V.  74HC4049 tolerates inputs above its own"
		(at 193.04 125.73 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a27b8fc3-f411-42f2-89e1-1323152d87c0")
	)
	(text "VCC, which is exactly what makes it legal here.  Two inverters"
		(at 193.04 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4f1c91d5-8b57-4fac-b057-f9422907816c")
	)
	(text "per signal so BCLK polarity is preserved -- inverting BCLK would"
		(at 193.04 130.81 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "24a2dddb-dd70-4b7d-a789-7adc22d4c132")
	)
	(text "make the Pi sample on the data transition."
		(at 193.04 133.35 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f20f8a6d-dd8d-4b4b-9863-591439707838")
	)
