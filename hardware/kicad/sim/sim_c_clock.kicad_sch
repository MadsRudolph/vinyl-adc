	(text "The source swings 0-3.3 V, which is the case the 74HCT132"
		(at 10.16 83.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ee1c9b60-68ac-475a-8529-c8b436fa311f")
	)
	(text "is fitted for: HCT switches near 1.3 V instead of at half"
		(at 10.16 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ce557dc2-a03b-40ea-9c4a-e23173dfc000")
	)
	(text "supply, so a 3.3 V oscillator can -- or the Pi's GPCLK0 on"
		(at 10.16 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3d61388a-f716-400f-ba0a-87626e887b61")
	)
	(text "the bring-up jumper -- still meets VIH into a 5 V chain."
		(at 10.16 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4155f20a-645b-452f-b4ec-ffcfa93ab489")
	)
	(text "A plain 74HC here would want 3.5 V and might not switch."
		(at 10.16 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1ab3d1df-bc07-4979-ba29-ae8c326d9ff0")
	)
	(text "both inputs tied: a NAND used as the clock buffer"
		(at 60.96 63.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ed1b49a3-2f95-441d-b562-539e707d2e10")
	)
	(text "Q0=BCLK 3.072M  Q1=MCLK 1.536M"
		(at 124.46 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0d4da615-fd92-40c1-be15-86a95eb48af9")
	)
	(text "Q4=PUMP 192k  Q6=LRCLK 48k"
		(at 124.46 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c743a145-db96-494d-99e5-ddd2894752a1")
	)
	(text "Every output must be an exact binary division of 6.144 MHz"
		(at 12.7 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ac113b95-21d4-4df0-8d06-04cb9606d70b")
	)
	(text "at 50 % duty, and every one of them changes on a falling"
		(at 12.7 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "065b9f87-54a7-4711-9b7a-6e4b4e013b5b")
	)
	(text "master-clock edge -- which is where the Pi's I2S setup"
		(at 12.7 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "775e7919-948a-4d15-806e-2a250816c803")
	)
	(text "margin comes from.  The ripple delay through the counter"
		(at 12.7 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f97d4d93-7f30-4ad9-bf22-bf50a03bf658")
	)
	(text "eats into that margin: Q0 is one stage from CLK and Q6 is"
		(at 12.7 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "176057a8-c4f8-4207-867e-a152961afd08")
	)
	(text "seven, so watch the skew between BCLK and LRCLK, not just"
		(at 12.7 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e5f49fdd-0a24-494c-8202-fa13243ad627")
	)
	(text "their frequencies.  sim_g_interface spends what is left."
		(at 12.7 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ee723c77-a8a3-4da8-91d8-974c319d5b1b")
	)
	(text "Every stage is loaded with 1M: an output with nothing on it"
		(at 12.7 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "88d078b3-71aa-4c70-b15c-b670a0723cd8")
	)
	(text "tells you nothing, and every node wants a DC path."
		(at 12.7 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fe77a9a4-14a8-4eb0-8b5c-624cdb3d127f")
	)
	(text ".tran 1n 60u uic"
		(at 12.7 129.54 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "c435fa83-d531-46c4-8857-c4fddb06855d")
	)
	(text "<-  back to the board schematic   vinyl_adc.kicad_sch"
		(at 12.7 139.7 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		
			(href "file:../vinyl_adc.kicad_sch")
		)
		(uuid "e118d3ea-4883-4b5d-882d-d139343c99ef")
	)
