	(text "F  The 1-bit DAC  (74HC04 into 14k7 and 13k0, recentred by equal legs to -2.5 V)"
		(at 12.7 10.16 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "ebda6841-8d7e-46b4-bfdb-ecca9a854281")
	)
	(text "DACN from Q and DACP from /Q, so the two edges are as close"
		(at 71.12 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "499fd7a4-e2eb-43ff-bccd-92ece89e9c59")
	)
	(text "to simultaneous as the parts allow.  Any asymmetry between"
		(at 71.12 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dbe5ea6b-2654-4099-b489-7828559e4dbe")
	)
	(text "them is DAC inter-symbol interference, which is the one"
		(at 71.12 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "26a5473a-91bd-4a70-8902-abc0b85484a0")
	)
	(text "mechanism that can make a 1-bit DAC non-linear -- and the"
		(at 71.12 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e971bde9-5751-473c-9df1-eea28629f9fc")
	)
	(text "one this model does not have (docs/design-notes.md 9)."
		(at 71.12 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bd5d1909-3a3d-4e00-8e42-41d8db24f15c")
	)
	(text "INTO INTEGRATOR 1  (Rd = 14k7)"
		(at 203.2 25.4 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "372aff58-ffdb-47b9-85cf-9426a8cbdaf4")
	)
	(text "INTO INTEGRATOR 2  (Rd = 13k0)"
		(at 203.2 81.28 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "ef90eb9c-97f3-42ff-b86e-029051b5aaaf")
	)
	(text "The gate swings 0/5 V into Rd and an equal leg to -2.5 V"
		(at 12.7 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4b441c99-0d92-471d-ba72-c72d8392d5d6")
	)
	(text "recentres it, so the net feedback should be exactly +/-2.5 V"
		(at 12.7 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2c3f4ec9-2c47-4490-aaa7-a55dcbe02c13")
	)
	(text "-- which shows up as a triangle with equal up and down slopes"
		(at 12.7 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "297541ba-b869-4ce8-9479-4efa2b591708")
	)
	(text "of 2.5 / (Rd x 220p): 773 kV/s at integrator 1 and 874 kV/s"
		(at 12.7 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7e4fee4d-6aac-4e9c-b228-1bcb43d62faa")
	)
	(text "at integrator 2."
		(at 12.7 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8b3850ff-15de-43fc-95ef-e4384dba98ea")
	)
	(text "Any inequality between the two slopes is the 74HC04's own"
		(at 12.7 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a213846-367c-4013-a571-6c1848363752")
	)
	(text "50 ohm of output resistance, which the ideal model in"
		(at 12.7 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1b10f7ed-3516-4e0e-bfe8-11e552b65871")
	)
	(text "../../../sim does not have: it makes the high level"
		(at 12.7 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5216cf9a-5619-40c9-aa64-7328fa9c5922")
	)
	(text "5 x 14700/14750 rather than 5 V, so the two DAC levels are"
		(at 12.7 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3bc8564f-0851-40db-b54c-9b0debdd1e21")
	)
	(text "not quite symmetric about the reference.  That is a gain"
		(at 12.7 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f234ac3e-df9e-497d-b9da-0fefd19fded6")
	)
	(text "error and a DC offset, not distortion -- but it is worth"
		(at 12.7 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "366c5d8b-622a-48a5-aba0-85fb617b32ff")
	)
	(text "knowing the size of it."
		(at 12.7 175.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "57de69aa-1879-4fb3-8cb1-628801318bb8")
	)
	(text ".tran 5n 40u uic"
		(at 12.7 180.34 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "5c07601a-2a99-4dfb-8290-3d8261274c65")
	)
