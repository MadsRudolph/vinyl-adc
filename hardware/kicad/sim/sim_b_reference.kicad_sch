		)
		(uuid "904657a0-c466-47d1-b414-819056a7959b")
	)
	(text "B  The +/-2.5 V DAC reference  (ratiometric: it TRACKS the +5 V rail on purpose)"
		(at 12.7 10.16 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "73cd632b-383b-40b7-96a4-06a447313c3a")
	)
	(text "The +5 V rail is given 100 mV of 1 kHz hum deliberately."
		(at 10.16 83.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6a510a8f-8637-4c5e-a7d6-f9a5a93172bc")
	)
	(text "Because the divider tracks the same rail the DAC gate swings"
		(at 10.16 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1a99d400-3e66-4b7d-a08e-70774bf3fe60")
	)
	(text "between, that noise arrives as a common-mode GAIN modulation"
		(at 10.16 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ba55a6eb-9202-473d-a2b0-b1b9bde6b95a")
	)
	(text "at -98 dB rather than as additive noise -- so VREF_P must"
		(at 10.16 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7ed05207-3473-4a00-ba82-38d1bf47834c")
	)
	(text "stay at exactly half the rail, sample by sample.  Filtering"
		(at 10.16 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "641e09c5-6c25-4d84-8e93-30827aedde51")
	)
	(text "the reference instead of tracking it would break the"
		(at 10.16 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "299dbe71-5c44-416c-990a-e2bc1fb2df15")
	)
	(text "cancellation and inject the rail noise at full weight."
		(at 10.16 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6185f420-d429-4455-86d8-1f7716f5e45c")
	)
	(text "REFERENCE  (+/-2.5V, ratiometric -- tracks +5V so rail noise cancels as gain, not additive noise)"
		(at 71.12 12.7 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "c1b3a6cc-053f-49da-b906-a220c6240517")
	)
	(text "1k87 is what six DAC offset legs (14k7, 13k0, 8k25, twice)"
		(at 177.8 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9f701d35-330e-4eea-af5e-c1f45a730c19")
	)
	(text "look like from VREF_N.  VREF_P drives almost nothing: both"
		(at 177.8 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fc8f07f5-ce3b-425d-9597-09dc5a728acc")
	)
	(text "ends of Rsh sit at +2.5 V, so no current flows in it."
		(at 177.8 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fac7436d-c8b3-4ae5-8596-ad7880c1e26a")
	)
	(text ".tran 2u 3m"
		(at 12.7 124.46 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "cb480d30-feb8-4ad5-8a26-25a36696fcfe")
	)
	(text "<-  back to the board schematic   vinyl_adc.kicad_sch"
		(at 12.7 134.62 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		
			(href "file:../vinyl_adc.kicad_sch")
		)
		(uuid "718fc687-6a26-44d6-b639-d6ab58850c87")
	)
