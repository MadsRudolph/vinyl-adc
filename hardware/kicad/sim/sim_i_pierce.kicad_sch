	)
	(text "I  Pierce oscillator  (74HCU04 + 6.144 MHz crystal -- the 2-pin part that replaced the unobtainable can)"
		(at 12.7 10.16 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "9b29f078-b8b6-4a9d-adf9-6c7b4a70bb1a")
	)
	(text "The board's exact topology: Rf 1M biases the gate linear,"
		(at 12.7 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "180e9a41-17c5-4c1a-9108-98c0e30ea7bc")
	)
	(text "Rs 2k2 + C17 damp the crystal drive -- and kill the"
		(at 12.7 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6395a2ac-5ed6-4cd1-9194-34e84bf420d6")
	)
	(text "~30 MHz parasitic through Co that Rs=1k lets a gate"
		(at 12.7 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2eb29113-a07e-467f-ae78-e3032634f79e")
	)
	(text "sustain.  UNBUFFERED 74HCU04 only: a buffered 74HC04's"
		(at 12.7 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "302e71e8-27c6-402e-aafa-06163da349de")
	)
	(text "three-stage gain re-lights that parasitic at any Rs.  And"
		(at 12.7 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "423c2468-6e35-4327-afa9-47d0d8d93159")
	)
	(text "the second gate squares the raw node up for the jumper."
		(at 12.7 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3ee9bfc5-23e8-4bdc-b3f6-dc3709b3f81b")
	)
	(text "The crystal model resonates SERIES at exactly 6.144 MHz;"
		(at 12.7 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "54f4c726-1656-4017-ab49-2b3edf43ad06")
	)
	(text "parallel-mode operation pulls +Cm/2(CL+Co) ~ +0.05 %, so"
		(at 12.7 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "01886c9d-de54-455b-ae0b-c9d9815975ad")
	)
	(text "the frequency check brackets that, not fs itself."
		(at 12.7 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fb3a7d70-0db3-4bc8-9ee0-fd9f68df4b8c")
	)
	(text "Startup rides a 5 V kick through 10 p at t=1u; what is"
		(at 12.7 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "faae95cc-26e0-487f-abd6-45d6bb491949")
	)
	(text "asserted is that the loop SUSTAINS it at full swing long"
		(at 12.7 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0b973406-8b8b-4f18-9e06-e3e4bba3e599")
	)
	(text "after the kick is gone."
		(at 12.7 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ee1ea7d1-8761-4235-bc8e-315c460c5dfb")
	)
	(text ".tran 2n 400u uic"
		(at 12.7 127 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a7ef807a-0171-42ab-97b5-42f28166ddde")
	)
