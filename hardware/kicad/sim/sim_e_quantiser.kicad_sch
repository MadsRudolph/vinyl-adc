	)
	(text "E  Quantiser  (LM311 on a single +5 V, threshold on VREF_P, and the ELD shift)"
		(at 12.7 10.16 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "b37cb3b2-a890-496d-935d-2134bae37091")
	)
	(text "QUANTISER  (LM311 + retiming D-FF)"
		(at 157.48 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "533cce46-598c-4a68-b26f-ef1205e90259")
	)
	(text "R34 is the excess-loop-delay compensation: without it the"
		(at 157.48 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1e83d511-4dc1-449b-b1c5-ef97871033cd")
	)
	(text "LM311's 200 ns costs 8 dB and most of the overload margin."
		(at 157.48 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c17ce372-7dac-4c54-89e8-5036c833eb1a")
	)
	(text "R36 = R33 is what centres the threshold on VREF_P."
		(at 157.48 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e248450b-10c3-4460-890c-4a8032a18b54")
	)
	(text "Rb = Rs to +5 V is what centres the summing node on VREF_P:"
		(at 12.7 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ff38b09e-ab45-4e2d-a79b-0b59c22235a2")
	)
	(text "with the DAC at its mean the comparator switches at V3 = 0,"
		(at 12.7 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6bba578e-c8ad-4d26-bf4f-4e5272faf59b")
	)
	(text "so the quantiser's threshold costs no offset at all."
		(at 12.7 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0f00d634-6185-4555-ac91-efa852962eba")
	)
	(text "Both LM311 inputs then sit at +2.5 V, comfortably inside its"
		(at 12.7 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bd2b2e86-0855-4394-bcff-dbe631693b3c")
	)
	(text "single-supply common-mode range of 0.5 V to V+ - 1.5 V."
		(at 12.7 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d4eb6f6c-7f55-4f3d-8986-02be15d7613c")
	)
	(text "Rk0 = 165k is the excess-loop-delay compensation.  It moves"
		(at 12.7 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "89e2cf40-aed9-4871-b97c-188ac799568e")
	)
	(text "the threshold by +/-0.335 V of V3 as the DAC switches, which"
		(at 12.7 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "74a3a11b-f974-4330-a1a0-28a7e8146467")
	)
	(text "is |k0| = 0.335 / S3 = 0.335 / 1.47 = 0.228 -- the design's"
		(at 12.7 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "058e8f31-e5dc-4dc0-9fdf-a694ea522e5f")
	)
	(text "-0.225 as an E96 pair.  Without it the LM311's 200 ns costs"
		(at 12.7 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9df6de9a-79ad-4333-adba-c01140cbc1d4")
	)
	(text "8 dB and most of the overload margin."
		(at 12.7 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6e44d99b-faf9-4c69-b0cd-aa4c75bb9ad5")
	)
	(text ".tran 20n 1m uic"
		(at 12.7 162.56 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "4f5e4adf-689f-44e0-b2b3-37aa3f1c39c3")
	)
	(text "<-  back to the board schematic   vinyl_adc.kicad_sch"
		(at 12.7 172.72 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		
			(href "file:../vinyl_adc.kicad_sch")
		)
		(uuid "123f18f6-3f25-4c93-b598-ab7bbee94de9")
	)
