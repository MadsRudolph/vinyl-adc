	)
	(text "D  Integrator 1  (a1 = 0.247, and where the TL074 really saturates)"
		(at 12.7 10.16 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "c8a3f5b5-b1aa-4140-8d39-24eb8e6b2fcc")
	)
	(text "INTEGRATOR 1  (a1 = 0.247)"
		(at 165.1 17.78 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "e000e2f9-7a84-45c7-b343-6aa54ce13ec2")
	)
	(text "10k5 is what integrator 2's"
		(at 233.68 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b7b68263-f930-4aa2-a5b0-fd7eb3fac119")
	)
	(text "input resistor looks like"
		(at 233.68 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "435e49db-3632-4cda-958f-a22bc7c82933")
	)
	(text "The DAC toggles every clock period with the input at zero, so"
		(at 12.7 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d896e361-68cb-4cf1-9ff8-cbb61527e4ec")
	)
	(text "the output is a triangle whose peak-to-peak IS a1 x S1 ="
		(at 12.7 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "83305bf3-c1b3-469a-95d4-52fd5497ef8f")
	)
	(text "0.247 x 2.04 V = 0.503 V.  That is the loop coefficient read"
		(at 12.7 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f9f1080a-39f1-4d51-9710-4a0e74f439f6")
	)
	(text "straight off the plot, with no arithmetic in between."
		(at 12.7 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ffb00fe0-bc6a-49e3-b13b-74377f588b7f")
	)
	(text "At 40 us the input steps to full scale (3.486 Vpk) and the"
		(at 12.7 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0db646d8-260a-4233-981b-ebd2380fbfcd")
	)
	(text "integrator runs into its rail.  Where it stops is the number"
		(at 12.7 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ca597200-84f5-4ef3-b754-1d42f97ec319")
	)
	(text "the whole design leans on: there are no clamp parts, and the"
		(at 12.7 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4a2d47fe-b0d1-40ea-8840-37fd14a60d2f")
	)
	(text "op-amp's own saturation is the only thing that stops a vinyl"
		(at 12.7 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "48207140-0e9d-4c0c-b3a7-80a400cb9c79")
	)
	(text "click latching the modulator (docs/design-notes.md 4a)."
		(at 12.7 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1478a42a-0a75-416b-9bb6-fd43d17d2167")
	)
	(text "Watch SUM1 too: the TL074's input common-mode floor is"
		(at 12.7 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "787ce734-fa7b-4f18-b861-c2f4dd8da2ee")
	)
	(text "V- + 4 V = -1 V on these rails, and the virtual earth is only"
		(at 12.7 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "075bce9a-b617-4fbe-bda0-b6433608b521")
	)
	(text "a virtual earth while the amp is still in control."
		(at 12.7 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3977dbc2-798e-4f57-b814-4c6a0494ed0f")
	)
	(text ".tran 5n 80u uic"
		(at 12.7 149.86 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "fa71560b-869a-45c8-92d2-5002c2872a90")
	)
	(text "<-  back to the board schematic   vinyl_adc.kicad_sch"
		(at 12.7 160.02 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		
			(href "file:../vinyl_adc.kicad_sch")
		)
		(uuid "13552823-14d3-444e-9615-4bb2333312a2")
	)
