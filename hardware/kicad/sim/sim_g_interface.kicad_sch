	(text "G  The Pi interface  (retime -> interleave -> 3.3 V; is there any setup margin left?)"
		(at 12.7 10.16 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "5b98ec7a-3795-4e64-a424-45841568a8f2")
	)
	(text "Q0=BCLK 3.072M  Q1=MCLK 1.536M"
		(at 76.2 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "607ac354-ef1b-474d-a463-e9f3599d2f70")
	)
	(text "Q4=PUMP 192k  Q6=LRCLK 48k"
		(at 76.2 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1d88549d-0774-4d34-b749-5649348c32d6")
	)
	(text "the D-FFs that put the DAC edges on the clock"
		(at 213.36 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ed4d1e75-8df1-424f-b185-f41aec1164b0")
	)
	(text "instead of on the comparator's own delay"
		(at 213.36 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a5ba7368-2539-4108-857a-281499449caf")
	)
	(text "MCLK selects: DIN carries R,L,R,L... at 3.072 Mbps."
		(at 320.04 17.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0b5247af-66fe-4609-bafa-22e7a7777456")
	)
	(text "64 BCLK per LRCLK frame = 32 L bits + 32 R bits"
		(at 320.04 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7589059a-422d-4c2b-9a15-7277a3277d9a")
	)
	(text "= exactly one OSR-32 sample per channel."
		(at 320.04 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cea25561-39a4-48c8-b341-775cd4630964")
	)
	(text "Two inverters per signal, not one.  The 74HC4049 tolerates"
		(at 421.64 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3eae8b4f-61c2-49e1-b270-adae9f070488")
	)
	(text "an input above its own VCC -- it has no clamp diode to VCC --"
		(at 421.64 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4def1549-1c20-488e-9f39-c3ff66e91303")
	)
	(text "which is what makes the 5 V -> 3.3 V shift legal, but"
		(at 421.64 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "87d7e026-f629-4cde-bbe4-366593de7f5e")
	)
	(text "inverting BCLK would make the Pi sample on the data"
		(at 421.64 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c3162fd7-558b-4c71-a8e6-b55e66d1aa72")
	)
	(text "transition.  1M stands in for a GPIO input."
		(at 421.64 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9d819494-ecfb-41dc-92ba-f0a2144e7fdb")
	)
	(text "The claim under test: DIN changes on a BCLK falling edge and"
		(at 12.7 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "30aaf6a4-5f37-4eb3-b6f4-6efde4487c47")
	)
	(text "the Pi samples it on the rising one, so half a BCLK period --"
		(at 12.7 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "95de4c19-f81a-4777-adc5-7a5c5aab98e9")
	)
	(text "163 ns -- is the setup margin, with no retiming flip-flop"
		(at 12.7 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fd7e1da8-4915-4d58-aea1-9a3bd26a025b")
	)
	(text "needed anywhere.  What eats into it is skew: MCLK is one"
		(at 12.7 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4944a7fc-956e-46b8-871d-210783c11e8b")
	)
	(text "ripple stage further down the counter than BCLK, then the mux"
		(at 12.7 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3807d9c1-2e2e-468e-be64-1edd6be6b7a7")
	)
	(text "and two 4049 stages add their own, while PI_BCLK goes through"
		(at 12.7 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e11e0798-c310-441a-8758-b6e8b316fb55")
	)
	(text "two 4049 stages of its own.  Only the DIFFERENCE matters, and"
		(at 12.7 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "418833cb-5b08-4de4-b806-bd0c19f4e0f6")
	)
	(text "that is what this sheet measures."
		(at 12.7 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "35109bdb-286e-4155-a9be-efcacd3c27ae")
	)
	(text "L is held high and R low, so DIN must come out as a clean"
		(at 12.7 162.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "520ed4da-88b8-40bb-8680-129d649c1748")
	)
	(text "1.536 MHz square: any other pattern means the two channels"
		(at 12.7 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "432a7e28-64f4-47e1-9db3-7e8d53d24869")
	)
	(text "are not landing in alternate bit slots."
		(at 12.7 167.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "406e8245-3e81-4f1b-b603-33b263382952")
	)
	(text ".tran 2n 100u uic"
		(at 12.7 170.18 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "4dea4d12-f4f8-473b-8087-4146027980fd")
	)
	(text "<-  back to the board schematic   vinyl_adc.kicad_sch"
		(at 12.7 182.88 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		
			(href "file:../vinyl_adc.kicad_sch")
		)
		(uuid "aca7794c-ba9b-4a67-826b-526e3490db16")
	)
