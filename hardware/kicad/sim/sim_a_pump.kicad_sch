	)
	(global_label "PUMPNODE"
		(shape input)
		(at 125.73 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4bee4bc2-2358-4100-a887-ec267c0ba813")
	)
	(text "A  The -5 V charge pump  (74HC244 x8 paralleled, 192 kHz, loaded at 32 mA)"
		(at 12.7 10.16 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "be834ac7-3ecf-41c3-b078-61ac8d4476cc")
	)
	(text "PUMP is 4040 Q4 = 192 kHz, which is 4x the 48 kHz output"
		(at 10.16 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "41832f93-f923-4eaf-8512-42a79c7d9285")
	)
	(text "rate on purpose: whatever ripple survives lands exactly on a"
		(at 10.16 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "94d73688-036a-4c30-8a23-a86abe3a3141")
	)
	(text "null of the CIC decimator.  sim_c_clock makes it for real."
		(at 10.16 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9fdbcac8-b09b-4c39-ad19-7aec7fea4239")
	)
	(text "8 buffers paralleled ~= 32 mA;"
		(at 58.42 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "76e7ffc5-fec5-4f69-a07f-5e9cf30ca2b3")
	)
	(text "no charge-pump IC in the shop"
		(at 58.42 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ef3f67f8-ec7e-405b-abf8-d660f46d9bd9")
	)
	(text "192 kHz pump drive = 4x the 48 kHz output rate,"
		(at 113.03 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5306b1c5-0e28-415a-9211-d7437aad39f2")
	)
	(text "so residual ripple lands on a CIC decimator null."
		(at 113.03 82.55 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "de1c7d51-0b22-4728-a6c4-9d48a488a575")
	)
	(text "130R is the analog section: two TL074, a TL072 and the DAC"
		(at 121.92 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fd3f1e76-9517-49bb-abde-7a5fa308db02")
	)
	(text "offset legs, about 32 mA.  That current is the whole reason"
		(at 121.92 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "78e95214-b1d1-4bec-bbbb-75ea236d19a2")
	)
	(text "the comparators run on a single +5 V supply -- leaving them"
		(at 121.92 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d25ebc42-ae09-4b32-80dc-95e48a6a8a65")
	)
	(text "on the negative rail costs 8 mA and the TL074s then cannot"
		(at 121.92 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7f8f868e-48b7-49d9-b685-24ef52da1661")
	)
	(text "clear their 1.94 V peak swing."
		(at 121.92 104.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f2359255-b0a7-442d-a6dd-4b3f032b869a")
	)
	(text "Measured: -3.87 V at 29.8 mA, settling in about 40 ms, with"
		(at 12.7 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "619a2360-4fb7-4c07-8a9e-0e5a901cbd38")
	)
	(text "0.24 uV of ripple after 4R75 + 220u.  The design's \"under"
		(at 12.7 109.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "432cd5a8-6d49-40fe-8228-c2a06bcffa79")
	)
	(text "1 uV\" holds; its -4.1 V does not."
		(at 12.7 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1f305aec-b90b-4a01-a12f-299f8d9201d2")
	)
	(text "The pump's output resistance is about 16 ohm and it is set by"
		(at 12.7 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a53c9c15-1fdd-48dc-a02a-5eac6a1d41a8")
	)
	(text "the 74HC244's own on-resistance, not by 1/fC: 10 uF through"
		(at 12.7 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "becd0f44-4e40-43e8-9fea-4ff91ef597e4")
	)
	(text "4 ohm is a 40 us time constant against a 2.6 us half period,"
		(at 12.7 119.38 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "00d52df2-fea9-4e51-b952-9f9d6c2f01e1")
	)
	(text "so the flying cap never finishes charging.  A bigger C4 or a"
		(at 12.7 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bd153309-d2ff-4e0d-a4d8-9e9eff0a8eb0")
	)
	(text "faster PUMP will not fix that; only more parallel buffers"
		(at 12.7 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c83b64a9-d682-4d3b-8734-c5fdfaefe559")
	)
	(text "would -- and there are no more."
		(at 12.7 127 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "498a2334-20e7-401d-b558-64f1d9271665")
	)
	(text "The 40 ms matters at bring-up: measure the rail straight"
		(at 12.7 129.54 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4af1aebc-5d95-4797-ad53-5636002f34ba")
	)
	(text "after power-on and it is still climbing."
		(at 12.7 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cb3e2f48-b450-48a2-a190-2cda8d410c4c")
	)
	(text ".tran 200n 80m"
		(at 12.7 134.62 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "a8f65de8-6ada-4e0a-ad13-2d1b7eb151ce")
	)
	(text "<-  back to the board schematic   vinyl_adc.kicad_sch"
		(at 12.7 147.32 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		
			(href "file:../vinyl_adc.kicad_sch")
		)
		(uuid "282bd696-0e8e-407a-9236-f3c6004debca")
	)
