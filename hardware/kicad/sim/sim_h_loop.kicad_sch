		)
		(uuid "b927bb99-e50d-45a3-8053-ca96b2919077")
	)
	(text "H  One complete channel  -  3rd-order CT delta-sigma, fs 1.536 MHz, OSR 32"
		(at 12.7 10.16 0)
		(effects
			(font
				(size 2.4 2.4)
			)
			(justify left bottom)
		)
		(uuid "683ca4a5-4ee4-41a9-9a55-fa504ab144b0")
	)
	(text "The reference and MCLK are ideal sources here -- sim_b and"
		(at 152.4 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4174a532-7a84-446f-a856-f54b0a14b68b")
	)
	(text "sim_c are where they earn their numbers, and this run has to"
		(at 152.4 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dfedd44a-4905-43c6-9f92-9e664dd7d008")
	)
	(text "resolve a 1.536 MHz loop for 3 ms without also charging a"
		(at 152.4 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7a6113af-5d36-4622-9ac8-48432625556c")
	)
	(text "440 uF reservoir."
		(at 152.4 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "89bc30c7-129f-43dc-ac25-e75e49c2d90d")
	)
	(text "The NEGATIVE rail is not idealised, though: it is -3.87 V,"
		(at 152.4 35.56 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c660ba27-5404-4fc5-acb2-74098c3e4579")
	)
	(text "which is what sim_a measured the charge pump actually making"
		(at 152.4 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9141e026-16af-48a8-8453-5bfdc36da6c4")
	)
	(text "at 30 mA.  That is the rail the op-amps saturate against, and"
		(at 152.4 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b812e43d-950f-4035-b4b6-0514fea499bd")
	)
	(text "on this board saturation IS the clamp -- so idealising it to"
		(at 152.4 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f5bf9f4e-44bb-43dc-9357-88de8d8fcb6e")
	)
	(text "-5 V would hide the one thing this sheet exists to check."
		(at 152.4 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "44a96429-dbb8-4edf-b843-0be6f2eb9a8b")
	)
	(text "V6 is the signal at -8 dBFS, the design's nominal operating"
		(at 7.62 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e7d4bda6-1e98-4308-9c20-c8317231a2d6")
	)
	(text "point.  V7 is the click, in series with it: 40 us at three"
		(at 7.62 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3a635ccb-bebd-4f8c-8668-795d6ff9e086")
	)
	(text "times full scale, at t = 1.5 ms."
		(at 7.62 147.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bc95bf59-17ae-4c41-94c1-277661699f13")
	)
	(text "A 1-bit third-order loop that overloads does not come back"
		(at 7.62 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ae0a8156-5b37-4786-9dd1-b39341ac9b4d")
	)
	(text "on its own, and on a vinyl source that is not a corner case."
		(at 7.62 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "15f6f107-6541-47f3-9f0f-5f061d66f33a")
	)
	(text "The op-amps' own saturation is the only rescue -- there are"
		(at 7.62 154.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "805d693c-d96d-4f04-85ef-88baaf2e9dcc")
	)
	(text "no clamp parts anywhere on this board."
		(at 7.62 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8f742676-f39d-4789-9723-f09534796188")
	)
	(text "2u2 + 47k -> 1.5 Hz HP;  1k + 1n5 -> 106 kHz anti-alias."
		(at 43.18 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6c15b8d8-2f65-421b-b87c-a7159b6a52a5")
	)
	(text "Trim sets full scale: 3.5 Vpk (2.5 Vrms) at wiper max, and only"
		(at 43.18 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dd9d6775-1dc1-4b66-83b0-5607a47d7f3d")
	)
	(text "attenuates from there.  Overload is 0.70 FS = 1.7 Vrms in."
		(at 43.18 83.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ff1d0abf-57c7-4145-b8f4-76d0a4016d61")
	)
	(text "For a quieter source drop R21: FS = 2.5 V x R21/R22."
		(at 43.18 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5fba2fd4-b3df-44ab-869e-025513323d0c")
	)
	(text "INTEGRATOR 1  (a1 = 0.247)"
		(at 119.38 71.12 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "9305003d-b186-420d-9d5a-5ee12495487f")
	)
	(text "INTEGRATOR 2  (a2 = 0.321, + resonator)"
		(at 200.66 71.12 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "33cd55ef-17ea-4b28-a2b7-0cbd4191c90c")
	)
	(text "INTEGRATOR 3  (a3 = 0.611)"
		(at 281.94 71.12 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "3b715aa1-12cb-44a0-a7c9-a621cff1fcdb")
	)
	(text "RESONATOR INVERTER  (g = 0.0297)"
		(at 363.22 71.12 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "90e1345d-4420-4d7a-874d-12bb06bbd060")
	)
	(text "QUANTISER  (LM311 + retiming D-FF)"
		(at 436.88 76.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b95bca5c-cd52-4f61-bfb7-83f9ebc17374")
	)
	(text "R34 is the excess-loop-delay compensation: without it the"
		(at 436.88 78.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1c726995-7b8c-4fcf-a157-17610ac50780")
	)
	(text "LM311's 200 ns costs 8 dB and most of the overload margin."
		(at 436.88 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cb331271-b038-4b6f-8676-3b15cd78b33d")
	)
	(text "R36 = R33 is what centres the threshold on VREF_P."
		(at 436.88 83.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "53a29fe4-29ed-486c-a0c7-c65bd45d6bb6")
	)
	(text "DACN from Q and DACP from /Q, so the two DAC edges"
		(at 513.08 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7687aacb-407f-4aba-a5c8-b2c2ad02e224")
	)
	(text "are as close to simultaneous as the parts allow"
		(at 513.08 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1fee00dd-6e1a-4ca7-a101-79ce4e20e139")
	)
	(text "Three things to read off this sheet, in order of how much they matter."
		(at 12.7 193.04 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "24e0183a-6faa-4eb2-bea3-fa35795c4154")
	)
	(text "1. THE CLICK TEST.  At 1.5 ms a 40 us transient at three times full scale hits the input.  The loop must come back:"
		(at 12.7 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d7c79e72-43cf-4f93-8506-63afb2b458cb")
	)
	(text "   the integrators must return to their normal 1.4-1.5 V swing and QL must go on toggling.  A modulator that latches"
		(at 12.7 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "79844167-d26e-4e30-869e-7767ad47f440")
	)
	(text "   here is one that would need a power cycle after every click on the record."
		(at 12.7 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1ed6c681-17ae-4751-aa09-d0a9117b2d48")
	)
	(text "2. WHERE THE TL074 ACTUALLY SATURATES.  There are no clamp parts: the integrator state scales are chosen so the"
		(at 12.7 215.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "20a1f37a-fcc4-49d1-bb43-fc435ca9c89e")
	)
	(text "   op-amps' own output saturation IS the clamp.  The design assumed about +/-2.7 V on +/-5 V rails.  If the real part"
		(at 12.7 218.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2e9f50ba-d2ae-4b05-aca5-ff0cd08b4f27")
	)
	(text "   swings further, the clamp lands somewhere the Python model never simulated -- so measure it, do not assume it."
		(at 12.7 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5ef0e346-d5c0-4276-99e6-42b2ad5e8fe8")
	)
	(text "3. INTEGRATOR SWINGS AT -8 dBFS: 1.43 / 1.47 / 1.45 V, from docs/design-notes.md 3.  Bigger than that and the"
		(at 340.36 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "78fd2f9a-157b-4a56-951c-666ab604627c")
	)
	(text "   overload margin has gone somewhere; smaller and the quantisation noise is being spent for nothing."
		(at 340.36 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7636223d-48d9-4dbd-974e-5ce89ebeaceb")
	)
	(text "There is deliberately NO SNR figure here.  68 dB over a 20 kHz band at OSR 32 needs about a second of transient at"
		(at 340.36 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bca95b58-8676-4856-ab03-13b9ed2b34d7")
	)
	(text "nanosecond steps; sim/verify.py computes it properly in minutes and this sheet would take hours to say the same."
		(at 340.36 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2819a611-8aad-4d97-bf8f-500611cc68ab")
	)
	(text ".tran 10n 3m uic"
		(at 340.36 215.9 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "f48bbd8e-e82a-486b-9fe2-51af93137869")
	)
	(text "<-  back to the board schematic   vinyl_adc.kicad_sch"
		(at 12.7 233.68 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		
			(href "file:../vinyl_adc.kicad_sch")
		)
		(uuid "9b69f12d-65f4-4b07-b55e-f1eecc4eb923")
	)
