	)
	(text "CHANNEL L  -  3rd-order CT delta-sigma, fs 1.536 MHz, OSR 32"
		(at 20.32 6.35 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "be56e10c-7b63-464d-9156-0951fb6108d5")
	)
	(text "2u2 + 47k -> 1.5 Hz HP;  1k + 1n5 -> 106 kHz anti-alias."
		(at 25.4 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36475860-b453-41f9-a677-81beba139570")
	)
	(text "Trim sets full scale: 3.5 Vpk (2.5 Vrms) at wiper max, and only"
		(at 25.4 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1ed5a65d-aa06-4cb4-9c7d-3cebda882388")
	)
	(text "attenuates from there.  Overload is 0.70 FS = 1.7 Vrms in."
		(at 25.4 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "78618696-dade-46fd-8d37-98b49696fb21")
	)
	(text "For a quieter source drop R21: FS = 2.5 V x R21/R22."
		(at 25.4 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3761f2d4-c5db-4735-ad0c-e1130e602489")
	)
	(text "INTEGRATOR 1  (a1 = 0.247)"
		(at 96.52 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "efcd63e3-ac07-4431-abbb-b2de87f2109b")
	)
	(text "INTEGRATOR 2  (a2 = 0.321, + resonator)"
		(at 172.72 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "f9c6a278-e2fb-4c28-b9d6-b5939a338c6e")
	)
	(text "INTEGRATOR 3  (a3 = 0.611)"
		(at 248.92 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "b677c17e-a759-49eb-9e53-6601c1e15f93")
	)
	(text "RESONATOR INVERTER  (g = 0.0297)"
		(at 325.12 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "6aca9d2d-8652-47cc-9de1-ff50e88c5e19")
	)
	(text "QUANTISER  (LM311 + retiming D-FF)"
		(at 398.78 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cb285996-a95d-42c5-9220-95fbe159b046")
	)
	(text "R34 is the excess-loop-delay compensation: without it the"
		(at 398.78 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "83333161-adf6-4e7f-8a99-2be140cd701d")
	)
	(text "LM311's 200 ns costs 8 dB and most of the overload margin."
		(at 398.78 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "64f2e31a-bb6d-45b6-a8e3-a358fe891154")
	)
	(text "R36 = R33 is what centres the threshold on VREF_P."
		(at 398.78 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36e94553-b67b-478e-abdd-688b6b40fcea")
	)
	(text "TO CHANNEL L, 14-way IDC ribbon.  Both supplies, both references,"
		(at 515.62 137.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "da40d973-99e6-462f-8421-356dcb617be5")
	)
	(text "and the three nets that carry the modulator loop across: the"
		(at 515.62 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "83571997-21d9-4731-933b-f827cfea2dd1")
	)
	(text "comparator out, and the DAC's two drives back to the summing"
		(at 515.62 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3250dad7-9138-4d4c-8d55-0647a614ba78")
	)
	(text "junctions.  Odd pins are all GND.  Shrouded and keyed."
		(at 515.62 144.78 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9ef7d9de-280d-47f4-bffe-58cb1dc63685")
	)
