	(text "CHANNEL R  -  3rd-order CT delta-sigma, fs 1.536 MHz, OSR 32"
		(at 20.32 6.35 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "58efa2c9-d43c-480e-8ec8-0942aaef1019")
	)
	(text "2u2 + 47k -> 1.5 Hz HP;  1k + 1n5 -> 106 kHz anti-alias."
		(at 25.4 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5324dba0-83cc-4ab3-bea9-d563072effde")
	)
	(text "Trim sets full scale: 3.5 Vpk (2.5 Vrms) at wiper max, and only"
		(at 25.4 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "edd9a860-5076-44e0-9870-95e082a67944")
	)
	(text "attenuates from there.  Overload is 0.70 FS = 1.7 Vrms in."
		(at 25.4 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "198d48fa-c590-476d-bbb2-bb0edc2f4169")
	)
	(text "For a quieter source drop R61: FS = 2.5 V x R61/R62."
		(at 25.4 29.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "65aa4ea7-fa67-457c-b9d9-88d22b5e64a5")
	)
	(text "INTEGRATOR 1  (a1 = 0.247)"
		(at 96.52 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "11cbcfe7-85c9-43d2-b4a4-7d5aa507e779")
	)
	(text "INTEGRATOR 2  (a2 = 0.321, + resonator)"
		(at 172.72 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "05f73df7-2ea9-4c51-a1c3-10c325125984")
	)
	(text "INTEGRATOR 3  (a3 = 0.611)"
		(at 248.92 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "4fa6e25d-679d-4e88-95df-058e792e8bf4")
	)
	(text "RESONATOR INVERTER  (g = 0.0297)"
		(at 325.12 13.97 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "8e6a8872-8c7e-42ce-8447-fbc43371b424")
	)
	(text "QUANTISER  (LM311 + retiming D-FF)"
		(at 398.78 19.05 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1357420a-bf16-4b0d-ae1f-7dcffe197c4a")
	)
	(text "R74 is the excess-loop-delay compensation: without it the"
		(at 398.78 21.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "11264657-48b9-4203-869b-60d20b3ea411")
	)
	(text "LM311's 200 ns costs 8 dB and most of the overload margin."
		(at 398.78 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "88a000b2-8dca-45a0-8618-8c12a1e7abf9")
	)
	(text "R76 = R73 is what centres the threshold on VREF_P."
		(at 398.78 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a89f7177-1a41-4cbe-8cee-79c029a7a0d7")
	)
	(text "1-BIT DAC DRIVE"
		(at 177.8 102.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c5f9c507-7875-4d64-8d5f-4ee21c60289b")
	)
	(text "DACN = /Q, DACP = Q (taken from Q and /Q so the"
		(at 177.8 105.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "086a0717-de4f-4ac7-9414-b48eee0010e7")
	)
	(text "two edges are as close to simultaneous as the parts allow)"
		(at 177.8 107.95 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4abc29fd-8739-47e7-a64e-1dae94dd96a6")
	)
	(text "STACKING BUS  2x8, 2.54 mm.  Every board carries this same connector at"
		(at 241.3 228.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "dd494740-75d5-4888-bff3-1c1b39fb83fb")
	)
	(text "the same coordinates; the stack is digital, channel L, channel R, power"
		(at 241.3 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "82a62826-b99f-4c5d-8050-d381de11b9e1")
	)
	(text "on 11 mm standoffs.  Odd pins are all GND, so every signal has a"
		(at 241.3 233.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d131d771-6e64-4ab9-b899-586b0a14787a")
	)
	(text "grounded neighbour either side -- which is what MCLK needs, its jitter"
		(at 241.3 236.22 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "cf261545-afad-47e1-8139-22eb30391265")
	)
	(text "being what sets this converter's noise floor."
		(at 241.3 238.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3beca5dd-913f-4034-9b0a-19426c0b8b0f")
	)
	(text "Q SELECT.  Shunt 1-2 = LEFT, 2-3 = RIGHT.  The two channel"
		(at 22.86 205.74 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9ad1b5c0-c82d-4c9e-8f8f-2b45c1c92742")
	)
	(text "boards are one artwork; this shunt is the only thing that"
		(at 22.86 208.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "0c98969f-9136-40e1-bbc0-794059b4958b")
	)
	(text "differs between them, so mark the board L or R when you fit it."
		(at 22.86 210.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a686f66a-11c3-453e-9f6d-2c4c13b7181c")
	)
