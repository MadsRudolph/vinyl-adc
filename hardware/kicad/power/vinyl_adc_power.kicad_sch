	(text "POWER  (Pi +5V -> charge-pump -5V -> +/-2.5V DAC reference)"
		(at 20.32 12.7 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "ec447aaa-9c4c-4150-a677-ef6e3071e1c0")
	)
	(text "Reservoir sits AT the DAC gate: the DAC's mean supply current"
		(at 20.32 57.15 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "df16711a-5c00-4697-a86b-0643b964a300")
	)
	(text "is proportional to the signal, so this rail must be LOW"
		(at 20.32 59.69 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "36a41698-3e9a-4dd5-8cf8-fd5a2229df0d")
	)
	(text "IMPEDANCE, not filtered by a series R."
		(at 20.32 62.23 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4b974f36-8b69-4bd5-9853-28d1397983b0")
	)
	(text "8 buffers paralleled ~= 32 mA;"
		(at 60.96 25.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "63bf2558-260a-4ab6-bdd8-9ce518fc3856")
	)
	(text "no charge-pump IC in the shop"
		(at 60.96 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a428a9fd-9809-4928-8cd1-b7080eecffbd")
	)
	(text "192 kHz pump drive = 4x the 48 kHz output rate,"
		(at 115.57 77.47 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3909403d-6fd8-4163-93be-f6c510c3d877")
	)
	(text "so residual ripple lands on a CIC decimator null."
		(at 115.57 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f675d324-5c40-4e46-9987-e8ab0eb40482")
	)
	(text "REFERENCE  (+/-2.5V, ratiometric -- tracks +5V so rail noise cancels as gain, not additive noise)"
		(at 180.34 12.7 0)
		(effects
			(font
				(size 2.0 2.0)
			)
			(justify left bottom)
		)
		(uuid "46827c32-eb1c-488e-bb05-0bec6b86d588")
	)
	(text "STACKING BUS  2x8, 2.54 mm.  Every board carries this same connector at"
		(at 266.7 83.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "450e495b-8c9e-4ef5-8106-d44a388b6d8e")
	)
	(text "the same coordinates; the stack is digital, channel L, channel R, power"
		(at 266.7 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f9b68f7d-f4e2-4755-8398-c0e328dcf3d6")
	)
	(text "on 11 mm standoffs.  Odd pins are all GND, so every signal has a"
		(at 266.7 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "47584c6d-db04-4be6-b576-83508ef23b80")
	)
	(text "grounded neighbour either side -- which is what MCLK needs, its jitter"
		(at 266.7 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "abc73c40-edab-4848-8123-bd88cb846f39")
	)
	(text "being what sets this converter's noise floor."
		(at 266.7 93.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bd5bb83e-841f-4f8b-bc64-96edb27446fc")
	)
