[Unit]
Description=Vinyl ADC live view (http://vinyladc.local:8091)
After=vinyl-adc-consumer.service network.target
Wants=vinyl-adc-consumer.service

[Service]
User=mads
WorkingDirectory=/home/mads/pi
ExecStart=/usr/bin/python3 /home/mads/pi/live.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
